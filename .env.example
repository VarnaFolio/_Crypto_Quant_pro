NODE_ENV=development
PORT=3000

# Production requires NODE_ENV=production and an explicit HTTPS CORS origin.
# With docker-compose.production.yml, set TLS_TERMINATION=proxy and mount TLS
# files for Nginx under ./tls; direct Node HTTPS uses TLS_KEY_PATH/TLS_CERT_PATH.
CORS_ORIGIN=http://localhost:3000
TLS_TERMINATION=node
TLS_KEY_PATH=
TLS_CERT_PATH=

# Persistence: use postgres in production; json is for local development only.
PAPER_STORAGE=json
DATABASE_URL=postgresql://postgres:password@localhost:5432/crypto_quant
DATABASE_POOL_MAX=10
DATABASE_SSL=false
SESSION_SECRET=generate-a-long-random-value
SESSION_TTL_MS=86400000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
MAX_REQUEST_BODY_BYTES=65536
LOG_LEVEL=info

# Gemini API key for backend-only AI requests.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Real trading must remain disabled until sandbox validation is complete.
REAL_TRADING_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_WITHDRAWALS_ENABLED=false
BINANCE_SANDBOX_MODE=true
BINANCE_API_URL=https://api.binance.com/api/v3
BINANCE_ACCOUNT_API_URL=https://api.binance.com

# Optional paper-trading risk controls.
MAX_PAPER_ORDER_QUOTE=5000
MAX_PAPER_DAILY_VOLUME=25000
MAX_REAL_ORDER_QUOTE=5000
MAX_REAL_DAILY_VOLUME=25000
PAPER_SPREAD_BPS=2
PAPER_SLIPPAGE_BPS=1
PAPER_FILL_FRACTION=0.5
ALERT_COOLDOWN_MS=300000